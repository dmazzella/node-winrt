<NavigationView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Name="NavView"
                PaneTitle="WinUI 3 Gallery"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False">
  <NavigationView.MenuItems>
    <NavigationViewItem x:Name="NavBasic" Content="Basic Input" Icon="TouchPointer" IsSelected="True" />
    <NavigationViewItem x:Name="NavText" Content="Text &amp; Numbers" Icon="Edit" />
    <NavigationViewItem x:Name="NavStatus" Content="Status &amp; Layout" Icon="AllApps" />
    <NavigationViewItem x:Name="NavDateColor" Content="Date, Time &amp; Color" Icon="Calendar" />
  </NavigationView.MenuItems>

  <Grid Padding="24,16,24,16" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock x:Name="PageTitle" Text="Basic Input" FontSize="24" FontWeight="SemiBold" />
      <TextBlock x:Name="RuntimeSubtitle"
                 Text="WinUI 3 Native Application + MicaBackdrop"
                 FontSize="12"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <!-- Page 1: Basic Input -->
    <ScrollViewer x:Name="BasicPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Padding="0,0,12,16">

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Buttons &amp; Flyouts" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="AccentBtn" Content="Accent Button" Style="{StaticResource AccentButtonStyle}" />
              <Button x:Name="StandardBtn" Content="Standard Button" ToolTipService.ToolTip="Native WinUI 3 Fluent Button" />
              <ToggleButton x:Name="ToggleBtn" Content="ToggleButton" />
              <RepeatButton x:Name="RepeatBtn" Content="Hold RepeatButton" Delay="250" Interval="75" />
              <HyperlinkButton Content="node-ctypes" NavigateUri="https://github.com/dmazzella/node-ctypes" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <DropDownButton Content="DropDownButton">
                <DropDownButton.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem x:Name="MenuNew" Text="New File" />
                    <MenuFlyoutItem x:Name="MenuSave" Text="Save" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="MenuAutoSave" Text="Auto-Save" IsChecked="True" />
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
              <SplitButton x:Name="DemoSplitBtn" Content="SplitButton">
                <SplitButton.Flyout>
                  <Flyout>
                    <TextBlock Text="Native WinUI 3 SplitButton Flyout!" />
                  </Flyout>
                </SplitButton.Flyout>
              </SplitButton>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Selection &amp; Toggles" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="28">
              <StackPanel Spacing="4">
                <CheckBox x:Name="CheckLogging" Content="Enable Logging" IsChecked="True" />
                <CheckBox x:Name="CheckMirror" Content="Electron Mirror Mode" />
              </StackPanel>
              <StackPanel Spacing="4">
                <RadioButton x:Name="RadioStandard" GroupName="Density" Content="Standard Density" IsChecked="True" />
                <RadioButton x:Name="RadioCompact" GroupName="Density" Content="Compact Density" />
              </StackPanel>
              <ToggleSwitch x:Name="FeatureSwitch" Header="Live Feature Flag" OnContent="Enabled" OffContent="Disabled" IsOn="True" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Slider, ProgressBar &amp; RatingControl" FontSize="15" FontWeight="SemiBold" />
            <Slider x:Name="DemoSlider" Header="Progress Value" Minimum="0" Maximum="100" Value="60" StepFrequency="5" />
            <ProgressBar x:Name="DemoProgress" Value="60" Maximum="100" />
            <RatingControl x:Name="DemoRating" Caption="Rate WinUI 3 on Node.js" Value="5" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Page 2: Text & Numbers -->
    <ScrollViewer x:Name="TextPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Padding="0,0,12,16">

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="TextBox, PasswordBox, NumberBox &amp; AutoSuggestBox" FontSize="15" FontWeight="SemiBold" />
            <TextBox x:Name="DemoTextBox"
                     Header="TextBox (updates InfoBar live)"
                     Text="Hello WinUI 3 from Node.js!"
                     PlaceholderText="Type something..." />
            <PasswordBox x:Name="DemoPasswordBox"
                         Header="PasswordBox (with reveal button)"
                         PlaceholderText="Enter password..." />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <NumberBox x:Name="DemoNumberBox"
                         Header="NumberBox"
                         Value="42"
                         Minimum="0"
                         Maximum="1000"
                         SmallChange="5"
                         SpinButtonPlacementMode="Inline"
                         Width="200" />
              <AutoSuggestBox x:Name="DemoSuggestBox"
                              Header="AutoSuggestBox"
                              PlaceholderText="Search WinRT namespaces..."
                              QueryIcon="Find"
                              Width="280" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="ComboBox &amp; RichTextBlock" FontSize="15" FontWeight="SemiBold" />
            <ComboBox x:Name="DemoCombo" Header="WinRT Subsystem" SelectedIndex="0" Width="280">
              <ComboBoxItem Content="Microsoft.UI.Xaml (WinUI 3)" />
              <ComboBoxItem Content="Windows.Media.Ocr" />
              <ComboBoxItem Content="Windows.Graphics.Capture" />
              <ComboBoxItem Content="Windows.Security.Credentials.UI" />
            </ComboBox>
            <RichTextBlock TextWrapping="Wrap">
              <Paragraph>
                Fluent WinUI 3 typography with <Bold>Bold</Bold>, <Italic>Italic</Italic>, and <Underline>Underline</Underline> spans using native <Bold>ThemeResource</Bold> Light/Dark brushes.
              </Paragraph>
            </RichTextBlock>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Page 3: Status & Layout -->
    <ScrollViewer x:Name="StatusPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Padding="0,0,12,16">

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="ProgressRing, Indeterminate ProgressBar &amp; Expander" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
              <ProgressRing x:Name="DemoRing" IsActive="True" Width="36" Height="36" />
              <ProgressBar IsIndeterminate="True" Width="260" VerticalAlignment="Center" />
              <ToggleSwitch x:Name="RingToggle" OnContent="Active" OffContent="Paused" IsOn="True" />
            </StackPanel>
            <Expander Header="WinUI 3 Expander (Click to collapse / expand)" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Spacing="6">
                <TextBlock Text="This Expander uses native XamlControlsResources Fluent v2 templates!" TextWrapping="Wrap" />
                <TextBlock Text="Running directly on Application.Start() + Window.Activate() + MicaBackdrop." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="ListView &amp; FlipView" FontSize="15" FontWeight="SemiBold" />
            <ListView x:Name="DemoList" Height="130">
              <x:String>node-ctypes — Zero-dependency LibFFI core</x:String>
              <x:String>@node-ctypes/comtypes — COM &amp; OLE Automation</x:String>
              <x:String>@node-ctypes/winrt — ECMA-335 .winmd &amp; WinUI 3</x:String>
              <x:String>@node-ctypes/uiautomation — UI Automation</x:String>
            </ListView>
            <FlipView Height="90" CornerRadius="6">
              <Border Background="#1D4ED8" Padding="18">
                <TextBlock Text="Slide 1 — Native WinUI 3 Application.Start() C++ Message Loop" FontSize="16" Foreground="White" VerticalAlignment="Center" />
              </Border>
              <Border Background="#047857" Padding="18">
                <TextBlock Text="Slide 2 — Real MicaBackdrop &amp; Fluent v2 Light/Dark Theme" FontSize="16" Foreground="White" VerticalAlignment="Center" />
              </Border>
              <Border Background="#7C3AED" Padding="18">
                <TextBlock Text="Slide 3 — Zero C++, Zero Electron, 100% TypeScript" FontSize="16" Foreground="White" VerticalAlignment="Center" />
              </Border>
            </FlipView>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Page 4: Date, Time & Color -->
    <ScrollViewer x:Name="DateColorPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Padding="0,0,12,16">

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Orientation="Horizontal" Spacing="24">
            <StackPanel Spacing="14">
              <DatePicker Header="DatePicker" />
              <TimePicker Header="TimePicker" />
              <CalendarDatePicker Header="CalendarDatePicker" PlaceholderText="Pick a date" />
            </StackPanel>
            <CalendarView />
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="ColorPicker (Fluent v2)" FontSize="15" FontWeight="SemiBold" />
            <ColorPicker x:Name="DemoColorPicker" IsColorSliderVisible="True" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Live Status InfoBar Footer -->
    <InfoBar x:Name="StatusBar"
             Grid.Row="2"
             IsOpen="True"
             IsClosable="False"
             Severity="Informational"
             Title="Ready"
             Message="Interact with any WinUI 3 Fluent control above." />
  </Grid>
</NavigationView>
